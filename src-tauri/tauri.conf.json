{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibranceGUIv2",
  "version": "2.2.0",
  "identifier": "com.tomasmarekk.vibranceguiv2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"VibranceGUI v2","width":1080,"height":840,"minWidth":760,"minHeight":620,"visible":false,"center":true,"decorations":false,"shadow":true,"theme":"Dark","backgroundColor":"#0f0f11"}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Tomas Marek",
    "category": "Utility",
    "shortDescription": "Automatic display color profiles for your games.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {"nsis":{"installMode":"currentUser","displayLanguageSelector":false},"webviewInstallMode":{"type":"downloadBootstrapper","silent":true}}
  }
}
